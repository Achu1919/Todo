<?xml version="1.0" encoding="utf-8"?>
<!-- v0.8.1: shown by Glance if composing the widget fails (instead of its generic error). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical"
    android:background="@drawable/widget_bg"
    android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="12dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Today" android:textSize="20sp" android:fontFamily="serif" android:textColor="@color/widget_ink" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:text="@string/widget_error" android:textSize="13sp" android:textColor="@color/widget_ink_secondary" />
</LinearLayout>
