<?xml version="1.0" encoding="utf-8"?>
<!--
  v0.10 Android Auto Backup (API 31+) and device-to-device transfer. Only the user's data goes:
  the Room database (todo.db + its WAL; the -shm index is rebuilt) and the settings DataStore.
  Not included: WorkManager's DB, Glance widget state (widget ids don't survive a restore), caches.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="todo.db" />
        <include domain="database" path="todo.db-wal" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="todo.db" />
        <include domain="database" path="todo.db-wal" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
